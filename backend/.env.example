# ==============================================================================
# AutoVista Environment Configuration Template (Backend)
# Copy this file to .env and configure your local environment credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# PostgreSQL 17 Database Credentials
DATABASE_URL=jdbc:postgresql://localhost:5432/autovista_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=CHANGE_ME
# JSON Web Token (JWT) Security
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
JWT_EXPIRATION_MS=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
